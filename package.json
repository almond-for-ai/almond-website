{
  "name": "almond-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && opennextjs-cloudflare build --skipNextBuild",
    "build:next": "next build",
    "start": "next start",
    "lint": "next lint",
    "deploy": "npm run build && opennextjs-cloudflare deploy",
    "deploy:staging": "npm run build && opennextjs-cloudflare deploy -- --env staging",
    "deploy:full-wip": "npm run build && opennextjs-cloudflare deploy -- --env full-wip",
    "preview": "npm run build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.6",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@thesvg/mcp-server": "^0.8.1",
    "gray-matter": "^4.0.3",
    "motion": "^12.40.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.0",
    "remark-html": "^16.0.1",
    "resend": "^6.18.1",
    "three": "^0.184.0",
    "yaml": "^2.9.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.184.1",
    "postcss": "^8.5.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
